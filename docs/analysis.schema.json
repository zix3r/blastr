        "filters": {
          "description": "Test name filters. Empty when the command runs the whole target:\nbecause every test of it is selected, or because so many are that\nnaming them would be longer than it is worth.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "package": {
          "description": "The Cargo package.",
          "type": "string"
