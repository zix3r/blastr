{
  "$defs": {
    "AnalysisKey": {
      "description": "Identifies exactly what a result describes. Two results with equal keys\ndescribe the same thing and may be shared.",
      "properties": {
        "all_features": {
          "description": "Whether every feature was enabled.",
          "type": "boolean"
        },
        "blastr": {
          "description": "The Blastr build: its version and a fingerprint of the executable,\nso that a rebuilt Blastr never reads what an older build computed.",
          "type": "string"
        },
        "cargo_lock": {
          "description": "Hash of `Cargo.lock`, empty when there is none.",
          "type": "string"
        },
        "cfg_test": {
          "description": "Whether `cfg(test)` was on.",
          "type": "boolean"
        },
        "exec": {
          "$ref": "#/$defs/ExecMode",
          "description": "Whether build scripts and procedural macros ran."
        },
        "features": {
          "description": "Enabled features, sorted.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "manifest_dir": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelPath"
            },
            {
              "type": "null"
            }
          ],
          "description": "The manifest directory analysed."
        },
        "repository": {
          "description": "Identifies the repository.",
          "type": "string"
        },
        "rust_analyzer": {
          "description": "The rust-analyzer library version.",
          "type": "string"
        },
        "source": {
          "description": "Identifies the content analysed: a tree hash, or a content-derived\nidentifier for the index or the working tree.",
          "type": "string"
        },
        "target": {
          "description": "Target triple; `None` means the host.",
          "type": [
            "null",
            "string"
          ]
        },
        "toolchain": {
          "description": "The Rust toolchain version.",
          "type": "string"
        }
      },
      "required": [
        "all_features",
        "blastr",
        "cargo_lock",
        "cfg_test",
        "exec",
        "features",
        "repository",
        "rust_analyzer",
        "source",
        "toolchain"
      ],
      "type": "object"
    },
    "AnalysisParams": {
      "description": "Everything that shapes an impact result besides the code itself.",
      "properties": {
        "depth": {
          "description": "Longest evidence path followed.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "ignore": {
          "description": "Glob patterns of files whose items are never listed.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "min_confidence": {
          "$ref": "#/$defs/Confidence",
          "description": "Lowest confidence listed."
        },
        "ranking": {
          "$ref": "#/$defs/RankingParams",
          "description": "Scoring weights."
        }
      },
      "required": [
        "depth",
        "ignore",
        "min_confidence",
        "ranking"
      ],
      "type": "object"
    },
    "Certainty": {
      "description": "How precisely a dependency edge was resolved.",
      "oneOf": [
        {
          "const": "resolved",
          "description": "Resolved to exactly one definition.",
          "type": "string"
        },
        {
          "const": "candidate",
          "description": "One of several possible targets.",
          "type": "string"
        }
      ]
    },
    "Change": {
      "description": "One structural difference between the two sides.",
      "properties": {
        "detail": {
          "$ref": "#/$defs/ChangeDetail",
          "description": "The specifics."
        },
        "kind": {
          "$ref": "#/$defs/ChangeKind",
          "description": "What kind of change it is."
        },
        "new": {
          "anyOf": [
            {
              "$ref": "#/$defs/Location"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where the symbol is on the head side."
        },
        "old": {
          "anyOf": [
            {
              "$ref": "#/$defs/Location"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where the symbol is on the base side."
        },
        "symbol": {
          "$ref": "#/$defs/SymbolPath",
          "description": "The symbol changed: its head-side identity, or its base-side identity\nwhen it no longer exists."
        }
      },
      "required": [
        "detail",
        "kind",
        "symbol"
      ],
      "type": "object"
    },
    "ChangeDetail": {
      "description": "The specifics of a change, depending on its kind.",
      "oneOf": [
        {
          "const": "none",
          "description": "The kind says everything.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "For `Field`, `Variant`, `TraitItem` and `Impl`: what happened to the member.",
          "properties": {
            "member": {
              "$ref": "#/$defs/Delta"
            }
          },
          "required": [
            "member"
          ],
          "type": "object"
        },
        {
          "const": "default-body",
          "description": "For `TraitItem`: only the body of a provided method changed.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "For `Renamed`: the previous identity.",
          "properties": {
            "renamed": {
              "properties": {
                "from": {
                  "$ref": "#/$defs/SymbolPath",
                  "description": "The symbol's path on the base side."
                }
              },
              "required": [
                "from"
              ],
              "type": "object"
            }
          },
          "required": [
            "renamed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "For `Visibility`: the two values.",
          "properties": {
            "visibility": {
              "properties": {
                "from": {
                  "$ref": "#/$defs/Visibility",
                  "description": "Visibility on the base side."
                },
                "to": {
                  "$ref": "#/$defs/Visibility",
                  "description": "Visibility on the head side."
                }
              },
              "required": [
                "from",
                "to"
              ],
              "type": "object"
            }
          },
          "required": [
            "visibility"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "For `Manifest`: a one-line description.",
          "properties": {
            "manifest": {
              "type": "string"
            }
          },
          "required": [
            "manifest"
          ],
          "type": "object"
        },
        {
          "const": "retyped",
          "description": "For `ConstValue`: the declared type changed, not only the value.",
          "type": "string"
        }
      ]
    },
    "ChangeKind": {
      "description": "What kind of change happened to a symbol between two revisions.",
      "oneOf": [
        {
          "const": "non-semantic",
          "description": "Whitespace, comments or formatting only.",
          "type": "string"
        },
        {
          "const": "body",
          "description": "The item body changed.",
          "type": "string"
        },
        {
          "const": "signature",
          "description": "The item signature changed.",
          "type": "string"
        },
        {
          "const": "visibility",
          "description": "The item visibility changed.",
          "type": "string"
        },
        {
          "const": "added",
          "description": "The item was added.",
          "type": "string"
        },
        {
          "const": "removed",
          "description": "The item was removed.",
          "type": "string"
        },
        {
          "const": "renamed",
          "description": "The item was renamed or moved.",
          "type": "string"
        },
        {
          "const": "field",
          "description": "A struct field was added, removed or retyped.",
          "type": "string"
        },
        {
          "const": "variant",
          "description": "An enum variant was added, removed or reshaped.",
          "type": "string"
        },
        {
          "const": "trait-item",
          "description": "A trait item was added, removed or changed.",
          "type": "string"
        },
        {
          "const": "impl",
          "description": "A trait implementation was added or removed.",
          "type": "string"
        },
        {
          "const": "const-value",
          "description": "A constant or static value or type changed.",
          "type": "string"
        },
        {
          "const": "type-alias",
          "description": "A type alias target changed.",
          "type": "string"
        },
        {
          "const": "macro-def",
          "description": "A macro definition changed.",
          "type": "string"
        },
        {
          "const": "attribute",
          "description": "An attribute on the item changed.",
          "type": "string"
        },
        {
          "const": "manifest",
          "description": "`Cargo.toml` features or dependency versions changed.",
          "type": "string"
        }
      ]
    },
    "ChangedFile": {
      "description": "A file that differs between the two sides.",
      "properties": {
        "old_path": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelPath"
            },
            {
              "type": "null"
            }
          ],
          "description": "The path on the base side when the file was renamed."
        },
        "path": {
          "$ref": "#/$defs/RelPath",
          "description": "The path on the head side, or on the base side for a deleted file."
        },
        "status": {
          "$ref": "#/$defs/FileStatus",
          "description": "How the file differs."
        }
      },
      "required": [
        "path",
        "status"
      ],
      "type": "object"
    },
    "Comparison": {
      "description": "The two sides being compared.",
      "properties": {
        "base": {
          "$ref": "#/$defs/Source",
          "description": "The older side."
        },
        "head": {
          "$ref": "#/$defs/Source",
          "description": "The newer side."
        }
      },
      "required": [
        "base",
        "head"
      ],
      "type": "object"
    },
    "Confidence": {
      "description": "How strongly the analysis believes an impact is real.",
      "oneOf": [
        {
          "const": "possible",
          "description": "The impact may exist but the evidence is weak.",
          "type": "string"
        },
        {
          "const": "likely",
          "description": "The impact is probable but not proven.",
          "type": "string"
        },
        {
          "const": "definite",
          "description": "The impact follows directly from a resolved dependency.",
          "type": "string"
        }
      ]
    },
    "Delta": {
      "description": "Whether something appeared, disappeared or was altered.",
      "oneOf": [
        {
          "const": "added",
          "description": "Present on the head side only.",
          "type": "string"
        },
        {
          "const": "removed",
          "description": "Present on the base side only.",
          "type": "string"
        },
        {
          "const": "modified",
          "description": "Present on both sides and different.",
          "type": "string"
        }
      ]
    },
    "DiffResult": {
      "description": "The result of comparing two sides structurally.",
      "properties": {
        "base_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalysisKey"
            },
            {
              "type": "null"
            }
          ],
          "description": "Identity of the base analysis; `None` for a plain directory."
        },
        "changed_files": {
          "description": "Files that differ.",
          "items": {
            "$ref": "#/$defs/ChangedFile"
          },
          "type": "array"
        },
        "changes": {
          "description": "Structural changes, in a stable order.",
          "items": {
            "$ref": "#/$defs/Change"
          },
          "type": "array"
        },
        "comparison": {
          "$ref": "#/$defs/Comparison",
          "description": "What was compared."
        },
        "head_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalysisKey"
            },
            {
              "type": "null"
            }
          ],
          "description": "Identity of the head analysis; `None` for a plain directory."
        },
        "limits": {
          "description": "What limits the result.",
          "items": {
            "$ref": "#/$defs/Limit"
          },
          "type": "array"
        }
      },
      "required": [
        "changed_files",
        "changes",
        "comparison",
        "limits"
      ],
      "type": "object"
    },
    "EdgeDetail": {
      "description": "Extra information some edges carry.",
      "oneOf": [
        {
          "const": "none",
          "description": "Nothing extra.",
          "type": "string"
        },
        {
          "const": "match-exhaustive",
          "description": "A `Matches` edge from a `match` that lists the variants and has no catch-all arm.",
          "type": "string"
        },
        {
          "const": "match-wildcard",
          "description": "A `Matches` edge from a `match` that has a catch-all arm.",
          "type": "string"
        },
        {
          "const": "with-rest",
          "description": "A `Constructs` or `Matches` edge to a struct whose literal or pattern\nends with `..`, so it does not name every field.",
          "type": "string"
        }
      ]
    },
    "EdgeKind": {
      "description": "A directed dependency edge from one symbol to another.",
      "oneOf": [
        {
          "const": "calls",
          "description": "A statically resolved call.",
          "type": "string"
        },
        {
          "const": "takes-as-value",
          "description": "A function referenced without being called.",
          "type": "string"
        },
        {
          "const": "uses-type",
          "description": "A type mentioned in a signature, body or bound.",
          "type": "string"
        },
        {
          "const": "reads-field",
          "description": "A read of a field.",
          "type": "string"
        },
        {
          "const": "writes-field",
          "description": "A write to a field.",
          "type": "string"
        },
        {
          "const": "constructs",
          "description": "A struct or variant literal.",
          "type": "string"
        },
        {
          "const": "matches",
          "description": "A destructuring pattern or match arm.",
          "type": "string"
        },
        {
          "const": "implements",
          "description": "A trait implementation for a type.",
          "type": "string"
        },
        {
          "const": "may-dispatch-to",
          "description": "A call through a trait object or generic bound that could reach this\nimplementation.",
          "type": "string"
        },
        {
          "const": "uses-value",
          "description": "A read of a constant or static.",
          "type": "string"
        },
        {
          "const": "contains",
          "description": "Module, type or impl containing an item.",
          "type": "string"
        },
        {
          "const": "expands",
          "description": "An invocation of a `macro_rules!` macro defined in the workspace.",
          "type": "string"
        }
      ]
    },
    "EvidencePath": {
      "description": "A chain of references leading from a change to an affected item.",
      "properties": {
        "change": {
          "description": "Index into [`DiffResult::changes`] of the change the path starts at.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "class": {
          "$ref": "#/$defs/ImpactClass",
          "description": "The class this path gives the item: the rule's class when the path\nhas one step, `Behaviour` when it has more."
        },
        "reason": {
          "$ref": "#/$defs/Reason",
          "description": "Why the first step applies."
        },
        "score": {
          "description": "The score of this path.",
          "format": "float",
          "type": "number"
        },
        "steps": {
          "description": "The steps, starting next to the change: `steps[0].to` is the changed\nsymbol (or its container) and the last step's `from` is the item.",
          "items": {
            "$ref": "#/$defs/EvidenceStep"
          },
          "type": "array"
        }
      },
      "required": [
        "change",
        "class",
        "reason",
        "score",
        "steps"
      ],
      "type": "object"
    },
    "EvidenceStep": {
      "description": "One step of an evidence path: `from` depends on `to`.",
      "properties": {
        "certainty": {
          "$ref": "#/$defs/Certainty",
          "description": "How certain the step is: the edge's certainty, or `Candidate` when\nthe rule that followed the edge is itself uncertain."
        },
        "detail": {
          "$ref": "#/$defs/EdgeDetail",
          "description": "The detail the edge carries."
        },
        "edge": {
          "$ref": "#/$defs/EdgeKind",
          "description": "The kind of the reference."
        },
        "from": {
          "$ref": "#/$defs/SymbolPath",
          "description": "The dependent symbol, the one this step reaches."
        },
        "site": {
          "$ref": "#/$defs/Location",
          "description": "Where the reference is written."
        },
        "to": {
          "$ref": "#/$defs/SymbolPath",
          "description": "The symbol it depends on."
        }
      },
      "required": [
        "certainty",
        "detail",
        "edge",
        "from",
        "site",
        "to"
      ],
      "type": "object"
    },
    "ExecMode": {
      "description": "How much execution the analysis is allowed during a build.",
      "oneOf": [
        {
          "const": "full",
          "description": "Build scripts and procedural macros run.",
          "type": "string"
        },
        {
          "const": "restricted",
          "description": "Neither build scripts nor procedural macros run.",
          "type": "string"
        }
      ]
    },
    "FileStatus": {
      "description": "How a file differs between the two sides.",
      "oneOf": [
        {
          "const": "added",
          "description": "Present on the head side only.",
          "type": "string"
        },
        {
          "const": "modified",
          "description": "Present on both sides with different content.",
          "type": "string"
        },
        {
          "const": "deleted",
          "description": "Present on the base side only.",
          "type": "string"
        },
        {
          "const": "renamed",
          "description": "Moved; `old_path` is set.",
          "type": "string"
        }
      ]
    },
    "ImpactClass": {
      "description": "Why a dependent symbol is affected by a change.",
      "oneOf": [
        {
          "const": "adaptation",
          "description": "The code refers to something whose shape changed and must be made\ncompatible with it.",
          "type": "string"
        },
        {
          "const": "behaviour",
          "description": "The code is unchanged but may now behave differently.",
          "type": "string"
        }
      ]
    },
    "ImpactItem": {
      "description": "One item affected by the changes.",
      "properties": {
        "class": {
          "$ref": "#/$defs/ImpactClass",
          "description": "`Adaptation` when any of its paths is one, else `Behaviour`."
        },
        "confidence": {
          "$ref": "#/$defs/Confidence",
          "description": "The confidence of the best path of that class."
        },
        "distance": {
          "description": "Number of steps of the best path of that class.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "location": {
          "$ref": "#/$defs/Location",
          "description": "Where the symbol is on the head side."
        },
        "path_count": {
          "description": "How many distinct paths reached the item, including the ones not kept.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "paths": {
          "description": "The best paths, at most three, highest score first.",
          "items": {
            "$ref": "#/$defs/EvidencePath"
          },
          "type": "array"
        },
        "score": {
          "description": "The highest score among the paths of that class.",
          "format": "float",
          "type": "number"
        },
        "symbol": {
          "$ref": "#/$defs/SymbolPath",
          "description": "The affected symbol, by its head-side identity."
        },
        "tags": {
          "$ref": "#/$defs/ImpactTags",
          "description": "Facts about the item."
        }
      },
      "required": [
        "class",
        "confidence",
        "distance",
        "location",
        "path_count",
        "paths",
        "score",
        "symbol",
        "tags"
      ],
      "type": "object"
    },
    "ImpactLimits": {
      "description": "What the impact result leaves out or is unsure about.",
      "properties": {
        "below_confidence": {
          "description": "Items dropped because their confidence is below the requested minimum.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "below_floor": {
          "description": "Items dropped because their score is below the floor.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "beyond_depth": {
          "description": "Items that exist only beyond the depth limit.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "candidate_steps": {
          "description": "Distinct candidate steps used by the listed paths.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "coarse_rules": {
          "description": "First steps taken by a rule that cannot tell exactly who is affected.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "ignored": {
          "description": "Items dropped because their file matches an `ignore` pattern.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "unresolved_in_reach": {
          "description": "Unresolved references written inside a changed symbol or a listed item.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "unresolved_total": {
          "description": "Unresolved references in the head graph.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "below_confidence",
        "below_floor",
        "beyond_depth",
        "candidate_steps",
        "coarse_rules",
        "ignored",
        "unresolved_in_reach",
        "unresolved_total"
      ],
      "type": "object"
    },
    "ImpactTags": {
      "description": "Facts about an affected item worth showing next to it.",
      "properties": {
        "changed": {
          "description": "The item itself is among the changes of this comparison. For an\n`Adaptation` item this means it was adapted in the same diff.",
          "type": "boolean"
        },
        "is_main": {
          "description": "The item is the `main` function of a binary.",
          "type": "boolean"
        },
        "is_pub_api": {
          "description": "The item is part of a library's public interface.",
          "type": "boolean"
        },
        "is_test": {
          "description": "The item is a test function.",
          "type": "boolean"
        }
      },
      "required": [
        "changed",
        "is_main",
        "is_pub_api",
        "is_test"
      ],
      "type": "object"
    },
    "Limit": {
      "description": "Something that limits how complete a result is.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A changed range lies in code that is inactive under this configuration.",
          "properties": {
            "changed-but-inactive": {
              "$ref": "#/$defs/Location"
            }
          },
          "required": [
            "changed-but-inactive"
          ],
          "type": "object"
        },
        {
          "const": "restricted",
          "description": "Build scripts and procedural macros were not run.",
          "type": "string"
        },
        {
          "const": "submodules",
          "description": "The repository has submodules, which are not analysed.",
          "type": "string"
        },
        {
          "const": "lfs",
          "description": "The repository uses Git LFS, whose content is not analysed.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "References that could not be resolved.",
          "properties": {
            "unresolved": {
              "properties": {
                "count": {
                  "description": "How many.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "count"
              ],
              "type": "object"
            }
          },
          "required": [
            "unresolved"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The procedural macros of crates the analysed code uses could not be\nloaded, so everything they expand to is missing from the graph.",
          "properties": {
            "macros-not-expanded": {
              "properties": {
                "crates": {
                  "description": "The crates whose macros failed, sorted and without duplicates.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "crates"
              ],
              "type": "object"
            }
          },
          "required": [
            "macros-not-expanded"
          ],
          "type": "object"
        }
      ]
    },
    "Location": {
      "description": "A range of source text in a file.",
      "properties": {
        "file": {
          "$ref": "#/$defs/RelPath",
          "description": "The file, relative to the repository root."
        },
        "span": {
          "$ref": "#/$defs/Span",
          "description": "The range inside the file."
        }
      },
      "required": [
        "file",
        "span"
      ],
      "type": "object"
    },
    "RankingParams": {
      "description": "The weights used to score evidence paths.",
      "properties": {
        "adaptation_weight": {
          "description": "Weight of the `Adaptation` class.",
          "format": "float",
          "type": "number"
        },
        "behaviour_weight": {
          "description": "Weight of the `Behaviour` class.",
          "format": "float",
          "type": "number"
        },
        "candidate_weight": {
          "description": "Weight of a candidate step; a resolved step weighs 1.",
          "format": "float",
          "type": "number"
        },
        "decay": {
          "description": "Multiplier applied for each step after the first.",
          "format": "float",
          "type": "number"
        },
        "score_floor": {
          "description": "Items scoring below this are counted, not listed.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "adaptation_weight",
        "behaviour_weight",
        "candidate_weight",
        "decay",
        "score_floor"
      ],
      "type": "object"
    },
    "Reason": {
      "description": "Why the first step of an evidence path reaches its item.",
      "oneOf": [
        {
          "const": "calls-changed",
          "description": "Calls a function whose body changed.",
          "type": "string"
        },
        {
          "const": "takes-changed-as-value",
          "description": "Passes a changed function around as a value.",
          "type": "string"
        },
        {
          "const": "dispatches-to-changed",
          "description": "Calls a trait method that may dispatch to the changed implementation.",
          "type": "string"
        },
        {
          "const": "signature-changed",
          "description": "Calls or names a function whose signature changed.",
          "type": "string"
        },
        {
          "const": "declaration-changed",
          "description": "Names a type or trait whose generics or bounds changed.",
          "type": "string"
        },
        {
          "const": "no-longer-visible",
          "description": "Refers to an item it can no longer see.",
          "type": "string"
        },
        {
          "const": "refers-to-removed",
          "description": "Refers to an item that no longer exists.",
          "type": "string"
        },
        {
          "const": "refers-to-renamed",
          "description": "Refers to an item under its previous name or path.",
          "type": "string"
        },
        {
          "const": "uses-changed-field",
          "description": "Reads, writes or destructures a field that was removed or retyped.",
          "type": "string"
        },
        {
          "const": "constructs-without-field",
          "description": "Builds the struct without the new field.",
          "type": "string"
        },
        {
          "const": "pattern-misses-field",
          "description": "Destructures the struct without the new field.",
          "type": "string"
        },
        {
          "const": "exhaustive-match-misses-variant",
          "description": "A `match` without a catch-all arm that does not handle the new variant.",
          "type": "string"
        },
        {
          "const": "wildcard-catches-new-variant",
          "description": "A `match` whose catch-all arm now also catches the new variant.",
          "type": "string"
        },
        {
          "const": "uses-changed-variant",
          "description": "Constructs or matches a variant that was removed or reshaped.",
          "type": "string"
        },
        {
          "const": "must-implement-trait-item",
          "description": "Implements a trait that gained or changed a required item.",
          "type": "string"
        },
        {
          "const": "uses-changed-trait-item",
          "description": "Uses a trait item that changed or was removed.",
          "type": "string"
        },
        {
          "const": "inherits-changed-default",
          "description": "Implements the trait without overriding the changed default method.",
          "type": "string"
        },
        {
          "const": "impl-resolution-changed",
          "description": "Calls a method of an implementation that was added or removed.",
          "type": "string"
        },
        {
          "const": "uses-changed-value",
          "description": "Uses a constant or static whose value changed.",
          "type": "string"
        },
        {
          "const": "uses-retyped-value",
          "description": "Uses a constant or static whose type changed.",
          "type": "string"
        },
        {
          "const": "uses-changed-alias",
          "description": "Uses a type alias whose target changed.",
          "type": "string"
        },
        {
          "const": "invokes-changed-macro",
          "description": "Invokes a macro whose definition changed.",
          "type": "string"
        },
        {
          "const": "attribute-changed",
          "description": "Calls a function whose attributes changed.",
          "type": "string"
        }
      ]
    },
    "RelPath": {
      "description": "A file path relative to the repository root, always with `/` separators.",
      "type": "string"
    },
    "SelectedTest": {
      "description": "A test worth running.",
      "properties": {
        "filter": {
          "description": "The name `cargo test` knows the test by: its path without the crate name.",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/Location",
          "description": "Where it is."
        },
        "reason": {
          "$ref": "#/$defs/TestReason",
          "description": "Why it was selected."
        },
        "symbol": {
          "$ref": "#/$defs/SymbolPath",
          "description": "The test function."
        }
      },
      "required": [
        "filter",
        "location",
        "reason",
        "symbol"
      ],
      "type": "object"
    },
    "Source": {
      "description": "One side of a comparison.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A committed tree.",
          "properties": {
            "tree": {
              "properties": {
                "id": {
                  "description": "The tree's object id, in hexadecimal.",
                  "type": "string"
                },
                "label": {
                  "description": "How to show it to the user: a short commit id or the revision text.",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "label"
              ],
              "type": "object"
            }
          },
          "required": [
            "tree"
          ],
          "type": "object"
        },
        {
          "const": "index",
          "description": "The Git index (staged content).",
          "type": "string"
        },
        {
          "const": "worktree",
          "description": "The working tree.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A plain directory outside Git. Used by tests.",
          "properties": {
            "dir": {
              "type": "string"
            }
          },
          "required": [
            "dir"
          ],
          "type": "object"
        }
      ]
    },
    "Span": {
      "description": "A range of source text.",
      "properties": {
        "end": {
          "description": "Byte offset one past the last character.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "end_line": {
          "description": "Line of the last character, starting at 1.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "description": "Byte offset of the first character.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start_line": {
          "description": "Line of the first character, starting at 1.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "end",
        "end_line",
        "start",
        "start_line"
      ],
      "type": "object"
    },
    "SymbolKind": {
      "description": "The kind of definition a symbol is.",
      "oneOf": [
