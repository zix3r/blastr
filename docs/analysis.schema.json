  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A complete impact analysis of one comparison.",
  "properties": {
    "diff": {
      "$ref": "#/$defs/DiffResult",
      "description": "What was compared and what changed structurally."
    },
    "items": {
      "description": "The affected items, best first: by score descending, then distance,\nthen path.",
