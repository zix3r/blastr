        "$ref": "#/$defs/ImpactItem"
      },
      "type": "array"
    },
    "limits": {
      "$ref": "#/$defs/ImpactLimits",
      "description": "What the result leaves out."
    },
    "params": {
      "$ref": "#/$defs/AnalysisParams",
      "description": "The parameters the result was computed with."
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "tests": {
      "$ref": "#/$defs/TestSelection",
      "description": "The affected tests."
    }
  },
  "required": [
    "diff",
    "items",
    "limits",
    "params",
    "schema_version",
    "tests"
  ],
  "title": "Blastr analysis",
  "type": "object"
}
