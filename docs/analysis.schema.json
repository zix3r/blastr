        "selected",
        "total"
      ],
      "type": "object"
    },
    "Visibility": {
      "description": "How widely an item can be named, from narrowest to widest.",
      "oneOf": [
        {
          "const": "private",
          "description": "Visible in its own module only.",
          "type": "string"
        },
        {
          "const": "restricted",
          "description": "`pub(super)` or `pub(in path)`.",
          "type": "string"
        },
        {
          "const": "crate",
